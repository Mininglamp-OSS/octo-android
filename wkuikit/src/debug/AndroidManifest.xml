    <application>
        <activity
            android:name="com.chat.uikit.chat.preview.InteractiveCardPreviewActivity"
            android:exported="false"
            android:label="AdaptiveCard 预览"
            android:theme="@style/Theme.AppCompat.DayNight" />
    </application>
</manifest>
