    <!-- ── Interactive Card (ContentType 17) 语义色 ────────────────────────────
         AC HostConfig 的 containerStyles 六种风格独立底色 + subtle 文字（全局 color999
         无夜间值，这里独立）。主文本 / stroke 复用 @color/colorDark / @color/dividerColor，
         它们已有夜间覆盖。深色值见 values-night/color.xml。 -->
    <color name="interactive_card_bg">#FFFFFF</color>
    <color name="interactive_card_bg_emphasis">#EEEEF2</color>
    <!-- accent 曾用淡紫色 #EBE8FE 强调主区，跟 web 效果图比对后决定回归白底 —— web 视觉是
         「白底 + 分隔线区隔」而不是「主区色块」，Android 侧对齐后头部 / 主区 / 表单三段在
         视觉上通过 spacing + hairline 分层，不靠背景色。深色模式同理跟 default 一致。 -->
    <color name="interactive_card_bg_accent">#FFFFFF</color>
    <color name="interactive_card_bg_good">#E7FBE9</color>
    <color name="interactive_card_bg_warning">#FFF8E5</color>
    <color name="interactive_card_bg_attention">#FFEBEB</color>
    <color name="interactive_card_text_subtle">#999999</color>
</resources>
