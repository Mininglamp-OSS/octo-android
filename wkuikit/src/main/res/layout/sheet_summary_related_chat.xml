<?xml version="1.0" encoding="utf-8"?>
<!--
 关联聊天 sheet (BottomSheetDialogFragment 内容).
 1:1 对齐 iOS OctoRelatedChatSheet:
   - 顶部 grabber + 标题 + 关闭
   - 来源标签
   - 引用列表 (每条 citation 展开成 contextBefore + hit + contextAfter)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical">

    <View
        android:id="@+id/grabber"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_summary_grabber" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <ImageView
            android:id="@+id/closeIv"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_summary_close"
            app:tint="@color/summary_text_60"
            android:contentDescription="@null"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/summary_related_chat_title"
            android:textColor="@color/summary_text_strong"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/sourceLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:textColor="@color/summary_text_60"
        android:textSize="13sp"
        tools:text="项目群" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listRv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false" />
</LinearLayout>
