<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#7C8DFF"
                android:endColor="#6A5CFB"
                android:angle="135" />
            <corners android:radius="10dp" />
            <size
                android:width="40dp"
                android:height="40dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_person_plus"
        android:gravity="center"
        android:width="22dp"
        android:height="22dp" />
</layer-list>
