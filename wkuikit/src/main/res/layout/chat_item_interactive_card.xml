<?xml version="1.0" encoding="utf-8"?>
<!-- 交互式卡片消息布局（ContentType 17）—— Option A：卡片即气泡。
     · BubbleLayout 保留（提供长按/选中/reaction/时间戳 等骨架），但视觉外壳淡化：
       padding=0、shadowRadius=0、气泡底色透明（由 Provider 侧 setBubbleNormalColor 完成）。
     · cardBoxLayout 是真正的"视觉气泡"：白底 + 1dp hairline + 8dp 圆角（shape_interactive_card_bg），
       clipToOutline 让 AdaptiveCard 子 View 圆角裁切。
     · wk_msg_status_layout 挪到卡片盒外（气泡下方），避免撑变卡片形状。
     · 对齐 web wk-interactive-card-sdk：hairline stroke, no shadow, no left rail. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <com.chat.base.views.BubbleLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp"
        app:shadowRadius="0dp">

        <FrameLayout
            android:id="@+id/interactiveCardBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_interactive_card_bg"
            android:clipChildren="true"
            android:clipToOutline="true">

            <FrameLayout
                android:id="@+id/interactiveCardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/interactiveCardFallbackTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:textColor="@color/colorDark"
                android:textSize="15sp"
                android:visibility="gone" />

            <!-- Action.Submit 提交中的覆盖层：半透明 scrim 把卡片压暗 + 居中 ProgressBar 转圈
                 （对齐 iOS 的 loading 态）；clickable=true 吸收点击，防止等 bot 回帧时重复点。
                 提交完成 / 10s 超时 / bot 改卡新帧到达时，Provider 把 visibility 设回 gone。 -->
            <FrameLayout
                android:id="@+id/interactiveCardSubmitOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#33000000"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:indeterminate="true" />
            </FrameLayout>
        </FrameLayout>

        <include layout="@layout/wk_msg_status_layout" />
    </com.chat.base.views.BubbleLayout>

</LinearLayout>
