<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/homeColor"
    android:orientation="vertical">

    <include layout="@layout/wk_title_bar_layout" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Normal 状态：申请注销 -->
            <LinearLayout
                android:id="@+id/normalLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/destroy_apply_title"
                    android:textColor="@color/colorDark"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/destroy_apply_subtitle"
                    android:textColor="#999999"
                    android:textSize="14sp"
                    android:gravity="center" />

                <!-- 警告卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/shape_corner_rectangle"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/destroy_warn_1"
                        android:textColor="@color/colorDark"
                        android:textSize="14sp"
                        android:drawablePadding="8dp"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/destroy_warn_2"
                        android:textColor="@color/colorDark"
                        android:textSize="14sp"
                        android:drawablePadding="8dp"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/destroy_warn_3"
                        android:textColor="@color/colorDark"
                        android:textSize="14sp"
                        android:drawablePadding="8dp"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/destroy_warn_4"
                        android:textColor="@color/colorDark"
                        android:textSize="14sp"
                        android:drawablePadding="8dp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>

                <!-- 密码输入框 -->
                <EditText
                    android:id="@+id/passwordEt"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/shape_corner_rectangle"
                    android:hint="@string/destroy_password_hint"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="15sp"
                    android:singleLine="true" />

                <!-- 申请注销按钮 -->
                <TextView
                    android:id="@+id/applyBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/shape_corner_rectangle_red"
                    android:gravity="center"
                    android:text="@string/destroy_apply_btn"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:alpha="0.5" />
            </LinearLayout>

            <!-- Applying 状态：冷静期 -->
            <LinearLayout
                android:id="@+id/applyingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/destroy_applying_title"
                    android:textColor="@color/colorDark"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <!-- 状态卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/shape_corner_rectangle"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/remainingDaysTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorDark"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/expireDateTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#999999"
                        android:textSize="14sp"
                        android:gravity="center" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="#E0E0E0" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/destroy_cooling_tip"
                        android:textColor="#999999"
                        android:textSize="13sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- 取消注销按钮 -->
                <TextView
                    android:id="@+id/cancelDestroyBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/shape_corner_rectangle"
                    android:gravity="center"
                    android:text="@string/destroy_cancel_btn"
                    android:textColor="@color/colorAccent"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/destroy_cooling_bottom_tip"
                    android:textColor="#999999"
                    android:textSize="12sp"
                    android:gravity="center" />
            </LinearLayout>

        </FrameLayout>
    </ScrollView>
</LinearLayout>
