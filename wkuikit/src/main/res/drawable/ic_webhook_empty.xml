<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="88dp"
    android:height="88dp"
    android:viewportWidth="80"
    android:viewportHeight="80">

    <!-- 圆角矩形浅灰底 -->
    <path
        android:pathData="M0,17.6 L0,62.4 A17.6,17.6 0 0 0 17.6,80 L62.4,80 A17.6,17.6 0 0 0 80,62.4 L80,17.6 A17.6,17.6 0 0 0 62.4,0 L17.6,0 A17.6,17.6 0 0 0 0,17.6 Z"
