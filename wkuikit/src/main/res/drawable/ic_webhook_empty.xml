            android:strokeColor="#7A8299"
            android:strokeWidth="4.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <!-- 右环（开口朝左）-->
        <path
            android:pathData="M 52.66 48.66 a 11 11 0 1 0 -7.78 7.78"
            android:strokeColor="#7A8299"
            android:strokeWidth="4.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <!-- 中间连接段 -->
        <path
            android:pathData="M 27.9 40 L 52.1 40"
            android:strokeColor="#7A8299"
            android:strokeWidth="4.5"
            android:strokeLineCap="round" />
    </group>
