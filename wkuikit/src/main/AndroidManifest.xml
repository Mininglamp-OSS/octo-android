<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <application>

        <activity android:name=".group.DeleteGroupMemberActivity" />
        <activity
            android:name=".group.GroupNoticeActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".group.GroupMdActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".group.GroupDetailActivity" />
        <activity android:name=".group.SavedGroupsActivity"
            android:launchMode="singleTop" />
        <activity android:name=".group.UpdateGroupNameActivity" />
        <activity
            android:name=".chat.ChooseChatActivity"
            android:windowSoftInputMode="adjustPan|stateHidden" />
        <activity
            android:name=".chat.choose.ForwardDirectoryActivity"
            android:windowSoftInputMode="adjustPan|stateHidden" />
        <activity android:name=".search.SearchUserActivity" />
        <!--  (#176): secondary pane in Activity Embedding split. -->
        <activity
            android:name=".chat.ChatPersonalActivity"
            android:resizeableActivity="true"
            android:configChanges="screenSize|screenLayout|smallestScreenSize|orientation|keyboardHidden" />
        <activity
            android:name=".chat.WKRichTextCaptionActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".contacts.ChooseContactsActivity"
            android:windowSoftInputMode="adjustPan|stateHidden" />
        <activity android:name=".contacts.ContactsActivity" />

        <activity android:name=".contacts.NewFriendsActivity"
            android:launchMode="singleTop" />
        <activity android:name=".contacts.SpaceMembersListActivity"
            android:launchMode="singleTop" />
        <activity android:name=".contacts.SpaceBotsListActivity"
            android:launchMode="singleTop" />
        <activity android:name=".contacts.BotStoreActivity"
            android:launchMode="singleTop" />
        <activity android:name=".contacts.MyGroupsListActivity"
            android:launchMode="singleTop" />
        <activity android:name=".setting.SettingActivity" />
        <activity android:name=".setting.DestroyAccountActivity" />
        <activity android:name=".group.GroupQrActivity" />
        <!--  (#176): secondary pane in Activity Embedding split. -->
        <activity android:name=".search.SearchAllActivity"
            android:resizeableActivity="true"
            android:configChanges="screenSize|screenLayout|smallestScreenSize|orientation|keyboardHidden" />
        <activity android:name=".user.MyInfoActivity" />
        <activity android:name=".user.UserQrActivity" />
        <activity android:name=".user.MyHeadPortraitActivity" />
        <activity android:name=".setting.MsgNoticesSettingActivity" />
        <!--  (#176): secondary pane in Activity Embedding split. -->
        <activity
            android:name=".user.UserDetailActivity"
            android:resizeableActivity="true"
            android:configChanges="screenSize|screenLayout|smallestScreenSize|orientation|keyboardHidden"
            android:launchMode="singleTop" />
        <activity android:name=".user.UpdateUserInfoActivity" />
        <activity android:name=".user.SetUserRemarkActivity" />
        <activity android:name=".search.AddFriendsActivity" />
        <activity android:name=".chat.PreviewNewImgActivity" />
        <activity android:name=".search.SearchMsgResultActivity" />
        <activity android:name=".chat.ChatMultiForwardDetailActivity" />
        <activity android:name=".setting.WKThemeSettingActivity" />
        <activity android:name=".setting.WKLanguageActivity" />
        <activity android:name=".group.WKAllMembersActivity" />
        <activity android:name=".thread.ThreadListActivity" />
        <activity android:name=".thread.ThreadDetailActivity" />
        <activity android:name=".thread.ThreadMembersActivity" />
        <activity
            android:name=".thread.CreateThreadActivity"
            android:windowSoftInputMode="adjustResize|stateVisible" />
        <activity android:name=".user.WKFileHelperActivity" />
        <activity android:name=".user.WKSystemTeamActivity" />
        <activity android:name=".group.WKSetGroupRemarkActivity" />
        <activity android:name=".setting.WKSetFontSizeActivity" />
        <activity
            android:name=".group.ChooseVideoCallMembersActivity"
            android:windowSoftInputMode="adjustPan|stateHidden" />
        <activity android:name=".setting.WKAboutActivity" />

        <activity android:name=".search.MailListActivity" />
        <activity android:name=".message.BackupRestoreMessageActivity" />
        <activity android:name=".setting.AppModulesActivity" />
        <activity android:name=".setting.ErrorLogsActivity" />
        <activity
            android:name="com.chat.uikit.TabActivity"
            android:resizeableActivity="true"
            android:configChanges="screenSize|screenLayout|smallestScreenSize|orientation|keyboardHidden"
            android:windowSoftInputMode="adjustPan"
            android:launchMode="singleTask"/>
        <activity android:name="com.chat.uikit.chat.ChatActivity"
            android:resizeableActivity="true"
            android:configChanges="screenSize|screenLayout|smallestScreenSize|orientation|keyboardHidden"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize" />
        <!--  (#176): secondary pane in Activity Embedding split. -->
        <activity android:name="com.chat.uikit.search.remote.GlobalActivity"
            android:resizeableActivity="true"
            android:configChanges="screenSize|screenLayout|smallestScreenSize|orientation|keyboardHidden" />
        <activity android:name="com.chat.uikit.chat.search.MessageRecordActivity" />
        <activity android:name="com.chat.uikit.chat.search.member.SearchWithMemberActivity" />
        <activity android:name="com.chat.uikit.chat.search.date.SearchWithDateActivity" />
        <activity android:name="com.chat.uikit.chat.search.image.SearchWithImgActivity" />
        <activity android:name="com.chat.uikit.chat.search.file.SearchWithFileActivity" />

        <service
            android:name="com.chat.uikit.AliveJobService"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity
            android:name="com.chat.uikit.chat.provider.TextPreviewActivity"
            android:theme="@style/Theme.AppCompat.Light"
            android:label="文件预览" />

        <activity
            android:name="com.chat.uikit.chat.provider.FileSaveActivity"
            android:theme="@style/Theme.AppCompat.Translucent" />

        <!-- 智能总结列表页 (上下文 Tab 主入口) -->
        <activity
            android:name="com.chat.uikit.summary.list.SmartSummaryListActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 智能总结详情页 -->
        <activity
            android:name="com.chat.uikit.summary.detail.SmartSummaryDetailActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 编辑总结正文 -->
        <activity
            android:name="com.chat.uikit.summary.detail.SmartSummaryEditActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- 发起总结 -->
        <activity
            android:name="com.chat.uikit.summary.create.SmartSummaryCreateActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <!-- 参与确认 -->
        <activity
            android:name="com.chat.uikit.summary.confirm.SmartSummaryConfirmActivity"
            android:configChanges="orientation|screenSize|keyboardHidden" />

    </application>
</manifest>
