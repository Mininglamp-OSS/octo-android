<?xml version="1.0" encoding="utf-8"?>
<!--
 筛选主页。对齐 iOS WKChannelHistoryFilterVC 的 UIModalPresentationFormSheet 弹窗效果：
   背后蒙层变暗(Activity 主题 FilterDialogTheme) + 四周留白、圆角悬浮卡片。
 卡片内部结构不变：标题栏(标题"筛选") → 分组列表(发送者/所在群聊或子区/包含成员/聊天类型/消息类型或文件类型/日期范围/排序)
   → 底部固定双胶囊按钮(重置/应用)。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="28dp"
        android:background="@drawable/filter_dialog_card_bg"
        android:clipToOutline="true"
        android:orientation="vertical"
        android:outlineProvider="background">

        <include layout="@layout/wk_title_bar_layout" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="15dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/resetTv"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/radian_filter_reset_layout"
                android:gravity="center"
                android:text="@string/filter_reset"
                android:textColor="@color/color999"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/applyTv"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/radian_purple_layout"
                android:gravity="center"
                android:text="@string/filter_apply"
                android:textColor="@color/white"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
